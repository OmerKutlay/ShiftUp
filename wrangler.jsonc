{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.mjs",
	"name": "shiftup",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "shiftup"
		}
	],
	// Gizli olmayan çalışma anı değişkenleri (publishable key herkese açıktır).
	// Secret'lar (SUPABASE_SECRET_KEY, CRON_SECRET) yalnızca Cloudflare panelinde tutulur.
	"vars": {
		"AUTH_MODE": "production",
		"NEXT_PUBLIC_SUPABASE_URL": "https://kdafwwshxowyrnwegmhv.supabase.co",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_zxaINtvro6I52UCF78DGew_GLAvQt2n"
	},
	// Varsayılan olarak wrangler deploy panelden eklenen değişkenleri siler; korunsun
	"keep_vars": true,
	// Workers Logs: her istek (invocation) + console.log satırları kaydedilir, örnekleme yok.
	// 1102 → Observability'de $workers.outcome = exceededCpu / exceededMemory ile bulunur;
	// aynı cf-ray'li `trace` satırları isteğin hangi adımda kesildiğini gösterir (src/lib/requestTrace.ts).
	// Traces: her Supabase alt isteğinin (fetch) süresi istek zaman çizelgesinde görünür.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	}
}
