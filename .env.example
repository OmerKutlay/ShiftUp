# Copy to .env.local and fill in your values

# ─── Supabase (Public) ────────────────────────────────────────
# Project URL — Supabase dashboard > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Publishable key (sb_publishable_...) — Project Settings > API Keys; frontend için güvenli
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ─── Supabase Admin (Server-side ONLY) ───────────────────────
# Secret key (sb_secret_...) — Project Settings > API Keys; ASLA frontend'e veya git'e koymayın
# Used only by: /api/qr/generate, /api/qr/process, /api/attendance/*, /api/store-location
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── Authentication Mode ──────────────────────────────────────
# 'development' → gerçek email gönderilmez, DEV_OTP kullanılır
# 'production'  → Supabase Auth email OTP kullanılır
AUTH_MODE=production
# DEV_OTP=12345

# Dev oturum çerezi HMAC anahtarı (opsiyonel; yoksa service role key kullanılır)
# DEV_SESSION_SECRET=uzun-rastgele-bir-deger

# ─── Cron ─────────────────────────────────────────────────────
# /api/attendance/alerts/scan için "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=uzun-rastgele-bir-deger

# Kiosk QR imza sırrı (isteğe bağlı; yoksa SUPABASE_SECRET_KEY'den türetilir)
# KIOSK_QR_SECRET=uzun-rastgele-bir-deger

# ─── Devam takibi ─────────────────────────────────────────────
# QR okutmada konum (geofence) zorunluluğu — yalnızca test için false yapın
# ATTENDANCE_REQUIRE_LOCATION=true

# ─── Çalışma süresi (yasal sınırların altına sıkılaştırılabilir) ─
# WT_MIN_REST_HOURS=11
# WT_MAX_DAILY_HOURS=11
# WT_MAX_WEEKLY_HOURS=45

# ─── Push bildirimleri (Web Push / VAPID) ─────────────────────
# Açık anahtar (gizli değildir) — `npx web-push generate-vapid-keys` ile üretilir.
# Tanımlı değilse push kapalıdır ve arayüz "Bildirimleri aç" kartını göstermez.
# Özel anahtar (VAPID_PRIVATE_KEY) uygulamaya DEĞİL, yalnızca send-push Edge Function secret'larına girer.
# VAPID_PUBLIC_KEY=BExxx...
