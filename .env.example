# Copy to .env.local and fill in your values

# ─── Supabase (Public) ────────────────────────────────────────
# Project URL — Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon/Public key — safe to expose in frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Supabase Admin (Server-side ONLY) ───────────────────────
# Service role key — NEVER expose in frontend code or commit to git
# Used only by: /api/qr/generate, /api/qr/process, /api/attendance/*, /api/store-location
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Authentication Mode ──────────────────────────────────────
# 'development' → gerçek email gönderilmez, DEV_OTP kullanılır
# 'production'  → Supabase Auth email OTP kullanılır
AUTH_MODE=production
# DEV_OTP=12345
